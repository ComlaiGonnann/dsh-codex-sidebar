{
  "name": "dsh-codex-rail",
  "version": "1.3.9",
  "displayName": "Codex Rail & Integrated Deck",
  "description": "Transforms DSH into a sleek dual-column Codex workspace with an integrated Activity Bar, unified topbar, avatar quick access, and smooth session history navigation.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "dsh-plugin",
    "dsh-codex-rail",
    "deepseek",
    "deepseek-harness",
    "dsh",
    "codex",
    "activity-bar",
    "sidebar",
    "ui-theme",
    "vibecoding"
  ],
  "author": "ComlaiGonnann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ComlaiGonnann/dsh-codex-rail.git"
  },
  "homepage": "https://github.com/ComlaiGonnann/dsh-codex-rail#readme",
  "bugs": {
    "url": "https://github.com/ComlaiGonnann/dsh-codex-rail/issues"
  },
  "license": "MIT",
  "engines": {
    "dsh": ">=0.1.1-rc.1"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}
